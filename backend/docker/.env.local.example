# ============================================
# RAG Medical Local Docker - environment template
# 使用方式:
#   cp backend/docker/.env.local.example backend/docker/.env.local
#   (按需修改后) docker compose --env-file .env.local -f docker-compose.yml up -d
# ============================================

SPRING_PROFILES_ACTIVE=docker
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---------- PostgreSQL (local docker, 映射到 15432) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=rag_medical
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me

# ---------- Redis (local docker, 映射到 16379) ----------
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# ---------- Qdrant (local docker, 映射到 16333) ----------
QDRANT_HOST=localhost
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334
QDRANT_API_KEY=change_me

# ---------- MinIO (local docker, 映射到 29000) ----------
MINIO_HOST=localhost
MINIO_PORT=29000
MINIO_ENDPOINT=http://localhost:29000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me

# ---------- Elasticsearch (local docker, 映射到 19200) ----------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=19200
ELASTICSEARCH_URIS=http://localhost:19200

# ---------- Etcd (local docker, 映射到 12379) ----------
ETCD_HOST=localhost
ETCD_PORT=12379
ETCD_URIS=http://localhost:12379

# ---------- LLM / Embedding / OCR (可指向外部服务) ----------
LLM_HOST=your-server-host
LLM_PORT=11434
LLM_BASE_URL=http://your-server-host:11434
LLM_MODEL=Qwen3.6-27BB
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

EMBEDDING_HOST=your-server-host
EMBEDDING_PORT=8082
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024

OCR_SERVICE_URL=http://your-server-host:38247
OCR_FALLBACK_URL=http://your-server-host:38248
OCR_ENABLED=true

# ---------- Application ----------
APP_HOST=0.0.0.0
APP_PORT=18080

# ---------- JWT ----------
JWT_SECRET=change_me_256bit_random_string
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Document processing ----------
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50
DOC_SUPPORTED_TYPES=pdf,docx,md,txt

# ---------- Qdrant collection ----------
QDRANT_COLLECTION=medical_documents
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# ---------- MinIO buckets ----------
MINIO_BUCKET_DOCUMENTS=rag-documents
MINIO_BUCKET_TEMP=rag-temp

# ---------- Monitoring ----------
PROMETHEUS_VERSION=v2.47.0
GRAFANA_VERSION=10.4.0
REDIS_EXPORTER_VERSION=v1.61.0
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
REDIS_EXPORTER_PORT=19121
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
