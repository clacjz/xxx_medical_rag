# ============================================
# RAG Medical Dev 环境变量模板
# 使用方式:
#   cp deploy/dev/.env.dev.example deploy/dev/.env.dev
#   docker compose --env-file .env.dev -f docker-compose.yml up -d
# ============================================

SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---------- 数据库 ----------
POSTGRES_HOST=your-server-host
POSTGRES_PORT=5432
POSTGRES_DB=rag_medical
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=your-server-host
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Qdrant ----------
QDRANT_HOST=your-server-host
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me

# ---------- MinIO ----------
MINIO_HOST=your-server-host
MINIO_PORT=9000
MINIO_ENDPOINT=http://your-server-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me

# ---------- Elasticsearch ----------
ELASTICSEARCH_HOST=your-server-host
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://your-server-host:9200

# ---------- Etcd ----------
ETCD_HOST=your-server-host
ETCD_PORT=2379
ETCD_URIS=http://your-server-host:2379

# ---------- LLM / Embedding / OCR ----------
LLM_HOST=your-server-host
LLM_PORT=11434
LLM_BASE_URL=http://your-server-host:11434
LLM_MODEL=Qwen3.6-27BB
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

EMBEDDING_HOST=localhost
EMBEDDING_PORT=8082
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024

OCR_SERVICE_URL=http://your-server-host:38247
OCR_FALLBACK_URL=http://your-server-host:38248
OCR_ENABLED=true

# ---------- Application ----------
APP_HOST=0.0.0.0
APP_PORT=18080
IP=your-server-host

# ---------- JWT ----------
JWT_SECRET=change_me_256bit_random_string
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Document processing ----------
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50
DOC_SUPPORTED_TYPES=pdf,docx,md,txt

# ---------- Qdrant collection ----------
QDRANT_COLLECTION=medical_documents
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# ---------- MinIO buckets ----------
MINIO_BUCKET_DOCUMENTS=rag-documents
MINIO_BUCKET_TEMP=rag-temp

# ---------- Monitoring ----------
PROMETHEUS_VERSION=v2.47.0
GRAFANA_VERSION=10.4.0
REDIS_EXPORTER_VERSION=v1.61.0
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
REDIS_EXPORTER_PORT=19121
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
