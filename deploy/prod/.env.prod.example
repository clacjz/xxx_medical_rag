# ============================================
# RAG Medical Prod 环境变量模板
# 使用方式:
#   cp deploy/prod/.env.prod.example deploy/prod/.env.prod
#   # 填写真实密钥后再启动
#   docker compose --env-file .env.prod -f docker-compose.yml up -d
#
# ⚠️ 生产环境所有 CHANGE_ME 必须替换为真实值，且不要提交到版本库。
# ============================================

SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC

# ---------- 数据库 ----------
POSTGRES_HOST=your-server-host
POSTGRES_PORT=5432
POSTGRES_DB=rag_medical
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Redis ----------
REDIS_HOST=your-server-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ---------- Qdrant ----------
QDRANT_HOST=rag-qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME

# ---------- MinIO ----------
MINIO_HOST=your-server-host
MINIO_PORT=9000
MINIO_ENDPOINT=http://your-server-host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME

# ---------- Elasticsearch ----------
ELASTICSEARCH_HOST=rag-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://rag-elasticsearch:9200

# ---------- Etcd ----------
ETCD_HOST=your-server-host
ETCD_PORT=2379
ETCD_URIS=http://your-server-host:2379

# ---------- LLM / Embedding / OCR ----------
LLM_HOST=your-server-host
LLM_PORT=11434
LLM_BASE_URL=http://your-server-host:11434
LLM_MODEL=Qwen3.6-27BB
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

EMBEDDING_HOST=your-server-host
EMBEDDING_PORT=8082
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024

OCR_SERVICE_URL=http://your-server-host:38247
OCR_FALLBACK_URL=http://your-server-host:38248
OCR_ENABLED=true

# ---------- Application ----------
APP_HOST=0.0.0.0
APP_PORT=18080
IP=your-server-host

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_256BIT_RANDOM_STRING
JWT_EXPIRATION=7200000
JWT_REFRESH_EXPIRATION=604800000

# ---------- RSA (用于敏感字段加密，留空则由应用生成/或禁用) ----------
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ---------- Document processing ----------
DOC_CHUNK_SIZE=500
DOC_CHUNK_OVERLAP=50
DOC_SUPPORTED_TYPES=pdf,docx,md,txt

# ---------- Qdrant collection ----------
QDRANT_COLLECTION=medical_documents
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# ---------- MinIO buckets ----------
MINIO_BUCKET_DOCUMENTS=rag-documents
MINIO_BUCKET_TEMP=rag-temp

# ---------- Monitoring ----------
PROMETHEUS_VERSION=v2.47.0
GRAFANA_VERSION=10.4.0
REDIS_EXPORTER_VERSION=v1.61.0
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
REDIS_EXPORTER_PORT=19121
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
